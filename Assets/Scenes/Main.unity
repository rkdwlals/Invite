--- !u!114 &1134118246
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1134118243}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5da35537f1b2424390940f6d567f6f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "\uB208\uCE58\uB97C \uBCF4\uB294 \uC815\uBE44\uACF5"
  dialogueSentences:
  - 
  - "\uC73C\uC544\uC544\uC544\uC545!"
  - "\uC544\uB2C8....\uADF8.....\uD6D4\uCCD0\uBCF8 \uAC8C \uC544\uB2C8\uB77C......"
  - "\uD639\uC2DC \uD0D0\uC815\uB2D8\uAED8\uC11C\uB3C4 \uCD08\uB300 \uBC1B\uC544
    \uC624\uC2E0 \uAC81\uB2C8\uAE4C....?"
  - "\uC800\uB294 \uADF8\uC800 \uC778\uACF5\uC9C0\uB2A5\uC744 \uC810\uAC80\uD558\uB824\uACE0
    \uD0C4 \uAE30\uC0AC\uC778\uB370,"
  - "\uBE44\uD589\uC120\uC744 \uD0C8 \uB54C, \uCD08\uB300 \uBC1B\uC740 \uC190\uB2D8\uC774
    \uD568\uAED8 \uD0C0\uC2E0 \uAC74 \uBD24\uC9C0\uB9CC"
  - "\uC774\uC0C1\uD558\uAC8C\uB3C4 \uBE44\uD589\uC120\uC5D0\uC11C \uB9C8\uC8FC\uCE5C
    \uC190\uB2D8\uC744 \uBCF8 \uC801\uC774 \uC5C6\uC5B4\uC11C \uB9D0\uC785\uB2C8\uB2E4\uC694....."
  - "\uD639\uC2DC \uBB50 \uC54C\uACE0 \uACC4\uC2DC\uB294 \uAC70 \uC5C6\uC73C\uC2ED\uB2C8\uAE4C?"
  - "\uC0AC\uC2E4 \uC800\uB3C4 \uC790\uC138\uD788\uB294 \uBAA8\uB974\uB294\uB370,
    \uB3C4\uC6C0\uC774 \uB420 \uAC83 \uAC19\uC544\uC11C......"
  - "\uB300\uC2E0 \uC774 \uC0AC\uC9C4\uC740 \uBE44\uBC00\uC785\uB2C8\uB2E4....!!"
