--- !u!114 &365703995
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 365703993}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5da35537f1b2424390940f6d567f6f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "\uC778\uACF5\uC9C0\uB2A5 \uC9D1\uC0AC \uB8E8\uD14C\uC778"
  dialogueSentences:
  - 
  - "\uBC18\uAC11\uC2B5\uB2C8\uB2E4, \uC800\uD0DD\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4."
  - "\uC800\uB294 \uC774 \uC800\uD0DD\uC758 \uC778\uACF5\uC9C0\uB2A5 \uBE44\uC11C
    \uB8E8\uD14C\uC778 \uC785\uB2C8\uB2E4."
  - "\uB9C8\uC2A4\uD130\uC758 \uBA85\uB839\uB300\uB85C \uC778\uC0AC\uB97C \uB4E4\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uB9C8\uC2A4\uD130\uC758 \uB179\uC74C\uC744 \uC7AC\uC0DD\uD569\uB2C8\uB2E4."
  - "\"\uCD08\uB300\uBC1B\uC740 \uC790\uC5EC, \uD658\uC601\uD558\uB124. \uB2F9\uC2E0\uC758
    \uC18C\uBB38\uC740 \uC775\uD788 \uB4E4\uC5C8\uC9C0\uB9CC, \uAD81\uAE08\uD574\uC11C
    \uB9D0\uC774\uC57C.\""
